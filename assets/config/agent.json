{
  "agent": {
    "enabled": true,
    "mode": "assist",
    "max_steps": 80,
    "max_retries_per_step": 3,
    "max_same_action_repeat": 3,
    "step_timeout_ms": 45000,
    "tool_timeout_ms": 120000,
    "step_delay_ms": 200,
    "observe_before_action": true,
    "verify_after_action": true,
    "reobserve_after_failure": true,
    "auto_retry_failed_action": true,
    "normalize_unknown_actions": true
  },
  "work_mode": {
    "default": "chat",
    "restore_last_control_mode_on_startup": false,
    "allow_chat": true,
    "allow_desktop_control": true,
    "allow_window_control": true,
    "allow_image_chat": true,
    "allow_screenshot_chat": true
  },
  "modes": {
    "observe": {
      "allow_action": false,
      "allow_uia_read": true,
      "allow_vision": true,
      "allow_shell": false
    },
    "assist": {
      "allow_action": true,
      "confirm_high_risk": true,
      "allow_uia": true,
      "allow_shell": true,
      "allow_vision": true
    },
    "auto": {
      "allow_action": true,
      "confirm_high_risk": true,
      "allow_uia": true,
      "allow_shell": true,
      "allow_vision": true
    }
  },
  "control_scope": {
    "desktop_control": {
      "enabled": true,
      "scope": "desktop",
      "allow_cross_window": true,
      "uia_refresh_interval_ms": 10000,
      "overlay_refresh_interval_ms": 250,
      "show_overlay": true,
      "show_clickable_only": true,
      "show_id": true,
      "show_type": true,
      "show_name": true,
      "idle_uia_refresh_interval_ms": 10000,
      "active_uia_refresh_interval_ms": 1000,
      "overview_max_depth": 2,
      "overview_max_items": 500,
      "full_scan_only_when_agent_active": true,
      "stable_overlay_swap": true,
      "preserve_previous_overlay_until_new_scan_ready": true
    },
    "window_control": {
      "enabled": true,
      "scope": "selected_window",
      "restrict_to_selected_hwnd": true,
      "allow_cross_window": false,
      "window_rect_refresh_interval_ms": 150,
      "uia_refresh_interval_ms": 1000,
      "overlay_refresh_interval_ms": 150,
      "vlm_refresh_mode": "on_demand",
      "stop_when_window_closed": true,
      "show_overlay": true,
      "show_clickable_only": true,
      "show_id": true,
      "show_type": true,
      "show_name": true,
      "stable_overlay_swap": true,
      "preserve_previous_overlay_until_new_scan_ready": true,
      "overlay_fill_enabled": false,
      "overlay_edge_only": true
    }
  },
  "tool_priority": [
    "mcp",
    "uia",
    "vision",
    "coordinate"
  ],
  "observation": {
    "scan_uia_before_first_step": true,
    "scan_uia_after_window_change": true,
    "scan_uia_after_click": true,
    "scan_uia_after_text_input": true,
