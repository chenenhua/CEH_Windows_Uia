    "continuous_keywords": [
      "一直",
      "持续",
      "不断",
      "连续聊天",
      "一直聊天",
      "持续监控",
      "直到",
      "为止",
      "一直聊",
      "聊到",
      "一直回复",
      "持续回复",
      "做客服",
      "客服值守",
      "有消息就回复",
      "来了消息就回复"
