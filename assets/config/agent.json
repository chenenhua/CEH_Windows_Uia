  "context": {
    "version": 2,
    "strategy": "local_bounded_state",
    "keep_recent_steps": 2,
    "summary_max_events": 4,
    "summary_persist_enabled": true,
    "recover_from_summary": true,
    "overflow_error_keywords": [
