    "uia_worker": {
      "enabled": true,
      "name": "UIAWorker",
      "com_apartment": "MTA",
      "queue_max_pending": 16,
      "shutdown_timeout_ms": 5000
    },
    "io_worker": {
      "enabled": true,
      "name": "IOWorker",
      "queue_max_pending": 32,
      "shutdown_timeout_ms": 3000
    }
