    "desktop_uia_scope": "desktop",
    "window_uia_scope": "selected_window"
  },
  "verification": {
    "enabled": true,
    "use_llm_verifier": true,
    "use_uia_verification": true,
    "use_visual_verification": true,
    "minimum_confidence": 0.75,
    "require_scope_match": true,
    "window_control_verify_selected_hwnd_only": true,
    "verify_observations_locally": true
