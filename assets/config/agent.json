  "user_interrupt": {
    "enabled": true,
    "mouse_move": true,
    "mouse_click": true,
    "keyboard_input": true,
    "ignore_ai_injected_input": true,
    "pause_agent_on_user_input": true,
    "sustain_ms": 5000,
    "continuity_gap_ms": 700,
    "single_mouse_move_interrupt": false,
    "single_click_interrupt": false,
    "single_key_interrupt": false
