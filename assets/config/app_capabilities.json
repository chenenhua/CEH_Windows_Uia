  "lifecycle_schema": {
    "preload": {
      "enabled": false,
      "commands": [
        {
          "program": "",
          "args": [],
          "working_directory": "",
          "wait_for_finished": true,
          "timeout_ms": 10000
        }
      ],
      "settle_ms": 0
    },
    "close": {
      "mode": "graceful_window_close",
      "verify_process_exit": true,
      "allow_force_kill": false
    },
    "launch_success": {
      "require_window": true,
      "allow_process_only": false,
      "description": "默认GUI应用必须确认有效顶层HWND才算启动成功；后台/托盘应用可在具体application.lifecycle.launch_success中显式允许process_only。"
    },
    "per_application_override_example": {
      "lifecycle": {
        "launch_success": {
          "require_window": false,
          "allow_process_only": true
        }
      }
    }
