{
  "app": {
    "name": "木头自动系统控制",
    "name_en": "CEH Windows AI Agent",
    "version": "1.0.0",
    "language": "zh-CN",
    "organization": "木头智能科技",
    "app_user_model_id": "CEH.Windows_Uia.Ai.V1"
  },
  "window": {
    "width": 500,
    "height": 1000,
    "frameless": true,
    "resizable": false,
    "allow_maximize": false,
    "always_on_top": false,
    "start_hidden": false,
    "hide_to_tray_on_green_button": true,
    "close_button_exit_program": true,
    "remember_position": true,
    "min_width": 500,
    "min_height": 800
  },
  "tray": {
    "enabled": true,
    "icon": "assets/img/icon/favicon_32x32.ico",
    "double_click_show_window": true,
    "show_notification_when_hidden": true,
    "notification_duration_ms": 2500
  },
  "paths": {
    "assets": "assets",
    "config": "assets/config",
    "models_config": "assets/config/models.json",
    "agent_config": "assets/config/agent.json",
    "camera_config": "assets/config/camera.json",
    "permissions_config": "assets/config/permissions.json",
    "tools_config": "assets/config/tools.json",
    "prompts": "assets/models/prompts",
    "prompt_system": "assets/models/prompts/system.txt",
    "prompt_planner": "assets/models/prompts/planner.txt",
    "prompt_verifier": "assets/models/prompts/verifier.txt",
    "prompt_vision": "assets/models/prompts/vision.txt",
    "database": "assets/db/wood.db",
    "database_schema": "assets/db/SQLite.sql",
    "style": "assets/style/main.qss",
    "upload": "assets/uppic",
    "log": "assets/uppic/log",
    "runtime_windows": "runtime/Windows",
    "app_capabilities_config": "assets/config/app_capabilities.json"
  },
  "ui": {
    "theme": "dark",
    "background": "#181818",
    "panel_background": "#141414",
    "popup_background": "#212121",
    "input_background": "#363636",
    "navigation_selected_background": "#262626",
    "title_separator": "#3c3c3c",
    "content_separator": "#222222",
    "text": "#ffffff",
    "text_secondary": "#8b8b8b",
    "text_hint": "#676767",
    "text_input": "#cccccc",
    "success": "#40c977",
    "error": "#ff6764",
    "warning": "#fb6a22",
    "accent": "#2c67c5",
    "accent_yellow": "#ffd240",
    "accent_purple": "#ad7bf9",
    "scroll_background": "#2b2b2b",
    "scroll_hover": "#c0c0c1",
    "default_font": "assets/font/light.ttf",
    "default_font_size": 12,
    "title_font_size": 16,
    "description_font_size": 10
  },
  "behavior": {
    "auto_load_config": true,
    "auto_create_missing_config": true,
    "auto_create_database": true,
    "auto_create_log_directory": true,
    "auto_scroll_log": true,
    "save_runtime_logs": true,
    "save_ai_raw_response": true,
    "save_screenshot_record": true,
    "stream_chat": true,
    "markdown_chat": true
  },
  "startup": {
    "check_runtime": true,
    "check_database": true,
    "check_models": true,
    "check_uia": true,
    "check_gpu": true,
    "auto_start_llm": false,
    "auto_start_vlm": false
  }
}